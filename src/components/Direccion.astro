---
// Direccion.astro
---

<section class="pt-12 relative">
  <div class="max-w-xl mx-auto text-center relative">
    <!-- TÍTULO DIRECCIÓN -->
    <div class="" id="titulo-direccion">
      <h2
        class="font-charm text-2xl md:text-3xl text-[#8E9198] font-bold tracking-wide"
      >
        RECEPCIÓN SOCIAL
      </h2>
    </div>

    <!-- 🏛️ ICONO DIRECCIÓN CON MARIPOSAS Y FLORES -->
    <div
      class="relative flex justify-center items-center mb-4"
      id="icono-direccion"
    >
      <!-- 🌸 FLOR LATERAL IZQUIERDA -->
      <div
        id="flor-dir-izq"
        class="absolute left-0 top-1/2 -translate-y-1/2 z-10"
      >
        <img
          src="/imagenes/FlorLateral.webp"
          alt="Flores izquierda"
          class="w-12 h-auto sm:w-20 md:w-24 lg:w-28 object-contain"
        />
      </div>

      <!-- 🦋 MARIPOSA IZQUIERDA -->
      <div class="mariposa-flotante flex items-center" id="mariposa-dir-izq">
        <img
          src="/gif/pajaritos.gif"
          alt="Mariposa"
          class="w-20 h-20 object-contain scale-x-[-1]"
        />
      </div>

      <!-- ICONO CENTRAL -->
      <img
        src="/imagenes/direccion.png"
        alt="Icono de dirección"
        class="w-24 h-24 pt-4 md:w-28 md:h-28 lg:w-32 lg:h-32 object-contain icono-dorado"
      />

      <!-- 🦋 MARIPOSA DERECHA -->
      <div class="mariposa-flotante flex items-center" id="mariposa-dir-der">
        <img
          src="/gif/pajaritos.gif"
          alt="Mariposa"
          class="w-20 h-20 object-contain"
        />
      </div>

      <!-- 🌸 FLOR LATERAL DERECHA -->
      <div
        id="flor-dir-der"
        class="absolute right-0 top-1/2 -translate-y-1/2 z-10"
      >
        <img
          src="/imagenes/FlorLateral.webp"
          alt="Flores derecha"
          class="w-12 h-auto sm:w-20 md:w-24 lg:w-28 object-contain scale-x-[-1]"
        />
      </div>
    </div>

    <!-- TÍTULO DIRECCIÓN -->
    <div class="mb-2" id="titulo-direccion">
      <h2
        class="font-charm text-2xl md:text-3xl text-[#8E9198] font-bold tracking-wide"
      >
        Dirección
      </h2>
    </div>

    <!-- INFORMACIÓN DE UBICACIÓN -->
    <div class="mb-2" id="info-direccion">
      <!-- Nombre del lugar -->
      <h3 class="font-charm text-xl md:text-2xl text-[#8E9198] font-bold mb-2">
        Salón de Eventos Galas
      </h3>

      <!-- Dirección -->
      <p
        class="font-charm px-6 text-xl md:text-xl text-[#85abbf] leading-relaxed mb-3"
      >
        Av. Los Ceibos esq. Pasaje Bolívar <br />
        Barrio Senac
      </p>

      <!-- Hora -->
      <p class="font-charm text-xl md:text-2xl text-[#8E9198] font-bold">
        Hora: 19:00
      </p>
    </div>

    <!-- BOTÓN VER UBICACIÓN -->
    <div class="flex justify-center" id="boton-ubicacion">
      <a
        href="https://maps.app.goo.gl/8sefLWMqVqsRSPUDA"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center
      gap-2 px-8 py-3 md:px-10 md:py-4 bg-[#85abbf] rounded-lg shadow-md
      hover:shadow-lg hover:bg-[#85abbf] transition-all duration-300"
      >
        <svg
          class="w-5 h-5 md:w-6 md:h-6 text-white"
          fill="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
          ></path>
        </svg>
        <span class="font-charm text-lg md:text-xl text-white font-semibold">
          Ver Ubicación
        </span>
      </a>
    </div>
  </div>

  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    if (typeof window !== "undefined") {
      document.addEventListener("DOMContentLoaded", () => {
        // Estado inicial
        gsap.set("#icono-direccion", { opacity: 0, scale: 0.8 });
        gsap.set("#titulo-direccion", { opacity: 0, scale: 0.9 });
        gsap.set("#info-direccion", { opacity: 0, scale: 0.9 });
        gsap.set("#boton-ubicacion", { opacity: 0, scale: 0.9 });
        gsap.set("#mariposa-dir-izq", { opacity: 0, x: -30 });
        gsap.set("#mariposa-dir-der", { opacity: 0, x: 30 });
        gsap.set("#flor-dir-izq", { opacity: 0, x: -150 });
        gsap.set("#flor-dir-der", { opacity: 0, x: 150 });

        ScrollTrigger.create({
          trigger: "#icono-direccion",
          start: "top 85%",
          end: "top 20%",
          onEnter: () => {
            const tl = gsap.timeline();

            tl.to(
              "#icono-direccion, #mariposa-dir-izq, #mariposa-dir-der, #titulo-direccion, #info-direccion, #boton-ubicacion",
              { opacity: 1, duration: 1, ease: "power2.out" },
            )
              .to(
                "#icono-direccion",
                { scale: 1, duration: 1, ease: "back.out(1.5)" },
                "<",
              )
              .to(
                "#mariposa-dir-izq",
                { x: 0, duration: 1, ease: "power2.out" },
                "<",
              )
              .to(
                "#mariposa-dir-der",
                { x: 0, duration: 1, ease: "power2.out" },
                "<",
              )
              .to(
                "#titulo-direccion, #info-direccion, #boton-ubicacion",
                { scale: 1, duration: 1, ease: "back.out(1.2)" },
                "<",
              );

            // 🌸 FLORES - Entran desde los bordes
            gsap.to("#flor-dir-izq", {
              opacity: 1,
              x: 0,
              duration: 1.5,
              ease: "power2.out",
            });
            gsap.to("#flor-dir-der", {
              opacity: 1,
              x: 0,
              duration: 1.5,
              ease: "power2.out",
            });

            // 🦋 FLOTADO CONTINUO DE MARIPOSAS
            gsap.to("#mariposa-dir-izq", {
              y: -15,
              x: 5,
              rotation: 5,
              duration: 3,
              ease: "sine.inOut",
              yoyo: true,
              repeat: -1,
              delay: 0.5,
            });
            gsap.to("#mariposa-dir-der", {
              y: -15,
              x: -5,
              rotation: -5,
              duration: 3.2,
              ease: "sine.inOut",
              yoyo: true,
              repeat: -1,
              delay: 0.7,
            });
          },
          onLeaveBack: () => {
            const tl = gsap.timeline();

            tl.to(
              "#icono-direccion, #mariposa-dir-izq, #mariposa-dir-der, #titulo-direccion, #info-direccion, #boton-ubicacion",
              { opacity: 0, duration: 0.5, ease: "power2.in" },
            )
              .to(
                "#icono-direccion",
                { scale: 0.8, duration: 0.5, ease: "power2.in" },
                "<",
              )
              .to(
                "#mariposa-dir-izq",
                { x: -30, duration: 0.5, ease: "power2.in" },
                "<",
              )
              .to(
                "#mariposa-dir-der",
                { x: 30, duration: 0.5, ease: "power2.in" },
                "<",
              )
              .to(
                "#titulo-direccion, #info-direccion, #boton-ubicacion",
                { scale: 0.9, duration: 0.5, ease: "power2.in" },
                "<",
              );

            // 🌸 FLORES - Salen hacia los bordes
            gsap.to("#flor-dir-izq", {
              opacity: 0,
              x: -150,
              duration: 0.5,
              ease: "power2.in",
            });
            gsap.to("#flor-dir-der", {
              opacity: 0,
              x: 150,
              duration: 0.5,
              ease: "power2.in",
            });
          },
        });

        console.log("📍🦋🌸 Sección de Dirección inicializada");
      });
    }
  </script>

  <style>
    .mariposa-flotante {
      will-change: transform;
      transition: all 0.3s ease;
    }

    .mariposa-flotante:hover {
      transform: scale(1.1) !important;
      filter: brightness(1.2);
    }

    .icono-dorado {
      filter: brightness(0) saturate(100%) invert(68%) sepia(18%) saturate(432%)
        hue-rotate(172deg) brightness(95%) contrast(88%);
      transition:
        filter 0.3s ease,
        transform 0.3s ease;
    }
  </style>
</section>
